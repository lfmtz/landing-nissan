# Copia este archivo a .env (local) o cárgalo en el panel de Vercel/Netlify.
# NUNCA subas el archivo .env a Git.

# --- Acceso a la app ---
# Contraseña para entrar a la app
APP_PASSWORD=cambia-esta-contraseña
# Cadena aleatoria larga (32+ caracteres) para firmar las sesiones.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Cuenta 1 ---
CLOUD_1_LABEL=Cuenta 1
CLOUD_1_NAME=
CLOUD_1_KEY=
CLOUD_1_SECRET=
# Opcional: fuerza el modo de folders (dynamic | fixed). Si lo omites se detecta solo.
# CLOUD_1_MODE=dynamic

# --- Cuenta 2 ---
CLOUD_2_LABEL=Cuenta 2
CLOUD_2_NAME=
CLOUD_2_KEY=
CLOUD_2_SECRET=

# --- Cuenta 3 ---
CLOUD_3_LABEL=Cuenta 3
CLOUD_3_NAME=
CLOUD_3_KEY=
CLOUD_3_SECRET=

# (Se admiten hasta 5 cuentas: CLOUD_4_*, CLOUD_5_*)
